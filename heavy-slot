#!/usr/bin/env bash
# A small, shared semaphore for machine-wide heavy jobs.  Bash 3.2 compatible.

set -u

SELF=$0
[ ! -L "$SELF" ] || SELF=$(readlink "$SELF")
# shellcheck source=coordinator/watchers/coord-lib.sh
. "$(cd "$(dirname "$SELF")" && pwd -P)/coordinator/watchers/coord-lib.sh"
IDENTITY_SCRIPT="$(cd "$(dirname "$SELF")" && pwd -P)/lib/process_identity.py"
CONFIG=$(orch_config_path)
CONFIG_PARENT=$(dirname "$CONFIG")
ORCH_HEAVY_SLOTS_MAX_WAS_SET=${ORCH_HEAVY_SLOTS_MAX+x}
config_error() {
  printf 'heavy-slot: cannot load %s: %s\n' "$CONFIG" "$1" >&2
  exit 78
}

config_warning() { printf 'heavy-slot: cannot load %s: %s; using defaults\n' "$CONFIG" "$1" >&2; }

config_unavailable() {
  if [ -n "$ORCH_HEAVY_SLOTS_MAX_WAS_SET" ]; then
    config_warning "$1"
  else
    config_error "$1"
  fi
}

if [ -n "${ORCH_CONFIG:-}" ] && [ ! -f "$CONFIG" ]; then
  config_error 'not a regular file'
fi

if [ -e "$CONFIG" ] || [ -L "$CONFIG" ]; then
  if [ ! -f "$CONFIG" ]; then
    config_unavailable 'not a regular file'
  elif [ ! -r "$CONFIG" ]; then
    config_unavailable 'not readable'
  elif ! LOADED=$({ orch_python >/dev/null && "$ORCH_LOADER_PYTHON" -I "$(orch_settings_module)" global "$CONFIG"; } 2>&1); then
    LOADED=${LOADED#ERROR: }
    config_unavailable "${LOADED#"$CONFIG": }"
  else
    eval "$LOADED"
  fi
else
  if [ -z "${ORCH_CONFIG:-}" ] && [ -f "$HOME/.claude/orchestration.env" ]; then
    config_unavailable "missing; run install.sh to convert $HOME/.claude/orchestration.env"
  fi
  CONFIG_ANCESTOR=$CONFIG_PARENT
  while { [ ! -e "$CONFIG_ANCESTOR" ] && [ ! -L "$CONFIG_ANCESTOR" ]; } && [ "$CONFIG_ANCESTOR" != / ]; do
    CONFIG_NEXT=$(dirname "$CONFIG_ANCESTOR")
    [ "$CONFIG_NEXT" = "$CONFIG_ANCESTOR" ] && break
    CONFIG_ANCESTOR=$CONFIG_NEXT
  done
  if { [ -e "$CONFIG_ANCESTOR" ] || [ -L "$CONFIG_ANCESTOR" ]; } && { [ ! -d "$CONFIG_ANCESTOR" ] || [ ! -x "$CONFIG_ANCESTOR" ]; }; then
    config_unavailable 'parent directory not searchable'
  fi
fi
SLOT_DIR=${ORCH_HEAVY_SLOTS_DIR:-"$HOME/.claude/heavy-slots"}
SLOT_MAX=${ORCH_HEAVY_SLOTS_MAX:-4}
LOCK_DIR="$SLOT_DIR/.lock"
RECLAIM_DIR="$SLOT_DIR/.lock-reclaim"
LOCK_MAX_AGE=30
WAIT_MAX=1800
KILL_GRACE=${ORCH_HEAVY_SLOTS_KILL_GRACE:-10}
LONG_RUN=${ORCH_HEAVY_SLOTS_LONG_RUN:-1800}
EVENTS_FILE="$SLOT_DIR/.events"
NOTES_DIR="$SLOT_DIR/.notes"
IDS_DIR="$SLOT_DIR/.ids"
JOB_NAME=
NOTE=-
JOB_START=
KILL_CODE=-
IDENTITY_LIMIT=10
IDENTITY=
PROBE_PID=
KILL_EVENT=0
EVENTS_MAX_BYTES=65536
CHILD_PID=
WATCH_PID=
SLOT_FILE=
LOCK_HELD=0

case $SLOT_MAX in ''|*[!0-9]*|0) printf 'heavy-slot: ORCH_HEAVY_SLOTS_MAX must be a positive integer\n' >&2; exit 64 ;; esac
case $KILL_GRACE in ''|*[!0-9]*) printf 'heavy-slot: ORCH_HEAVY_SLOTS_KILL_GRACE must be a non-negative integer\n' >&2; exit 64 ;; esac
case $LONG_RUN in ''|*[!0-9]*) printf 'heavy-slot: ORCH_HEAVY_SLOTS_LONG_RUN must be a non-negative integer\n' >&2; exit 64 ;; esac
LONG_RUN=$((10#$LONG_RUN))

usage() {
  printf 'usage: heavy-slot {count|list|stop <name>|take <architect>-<job> [--wait-max seconds] [--note text] -- <command> [args...]}\n       take exits 73 when the slot directory is not writable' >&2
  exit 64
}

die() { printf 'heavy-slot: %s\n' "$*" >&2; exit 64; }

cannot_write_slot_dir() {
  printf 'heavy-slot: cannot write %s (sandbox?); run this command escalated\n' "$SLOT_DIR" >&2
  [ "${CLEANUP_MODE:-0}" -eq 1 ] && return 73
  exit 73
}

cannot_use_lock_path() {
  printf 'heavy-slot: not a directory: %s\n' "$1" >&2
  [ "${CLEANUP_MODE:-0}" -eq 1 ] && return 73
  exit 73
}

lock_path_is_not_directory() {
  { [ -e "$1" ] || [ -L "$1" ]; } && [ ! -d "$1" ]
}

probe_slot_dir() {
  local probe="$SLOT_DIR/.write-probe.$$"
  mkdir -p "$SLOT_DIR" 2>/dev/null || { cannot_write_slot_dir; return $?; }
  if mkdir "$probe" 2>/dev/null && rmdir "$probe" 2>/dev/null; then
    return 0
  else
    rmdir "$probe" 2>/dev/null || true
    cannot_write_slot_dir
    return $?
  fi
}

clean_note() {
  local note
  note=$(printf '%s' "$1" | LC_ALL=C tr -c '[:print:]' ' ' | LC_ALL=C tr -s ' ')
  note=${note# }
  note=${note% }
  note=${note:0:60}
  printf '%s' "${note:--}"
}

# One printf is one write(2) on an O_APPEND file, so lines of concurrent jobs do not interleave.
emit_event() {
  local kind=$1 pid=$2 detail=$3 size
  size=$(wc -c 2>/dev/null <"$EVENTS_FILE") || size=0
  [ "$((size + 0))" -le "$EVENTS_MAX_BYTES" ] || return 0
  printf '%s\n' "$(date +%s) SLOT $kind $JOB_NAME pid=$pid $detail note=$NOTE" >>"$EVENTS_FILE" 2>/dev/null || true
}

job_elapsed() { printf '%ss' "$(( $(date +%s) - JOB_START ))"; }

emit_killed() {
  [ -n "$CHILD_PID" ] && [ "$KILL_EVENT" -eq 0 ] || return 0
  KILL_EVENT=1
  emit_event KILLED "$CHILD_PID" "code=$KILL_CODE elapsed=$(job_elapsed)"
}

watch_long() {
  local pid=$1 end=$(( JOB_START + LONG_RUN )) left fired=0
  trap 'kill $(jobs -p) 2>/dev/null; exit 0' TERM
  while is_pid_live "$pid"; do
    left=$(( end - $(date +%s) ))
    if [ "$left" -le 0 ] && [ "$fired" -eq 0 ]; then
      emit_event RUNLONG "$pid" "elapsed=$(job_elapsed)"
      fired=1
    fi
    [ "$fired" -eq 1 ] && left=30
    sleep "$(( left < 30 ? left : 30 ))" &
    wait $!
  done
}

# Killing the watcher alone leaves its foreground sleep behind, so the watcher runs the sleep in the
# background and its TERM trap kills it. After RUNLONG the watcher keeps running until the job ends or
# stop_watch kills it, so stop_watch rarely signals a freed pid.
# The watcher is started from a subshell, so it is not a child of this shell: bash 5.2 can print
# "wait_for: No record of process" into the job's stderr when a child dies during a command substitution.
start_watch() {
  WATCH_PID=$( (watch_long "$1" </dev/null >/dev/null 2>&1 & echo $!) )
}

stop_watch() {
  [ -n "$WATCH_PID" ] || return 0
  kill "$WATCH_PID" 2>/dev/null || true
  WATCH_PID=''
}

# signal_live <kill target...>: kill -0 succeeds or fails with EPERM (a sandbox or another user).
signal_live() {
  local err
  err=$(LC_ALL=C kill -0 "$@" 2>&1) && return 0
  case $err in *"not permitted"*) return 0 ;; esac
  return 1
}

is_pid_live() {
  case ${1:-} in ''|*[!0-9]*|0|0[0-9]*) return 1 ;; esac
  signal_live "$1"
}

is_group_live() {
  case ${1:-} in ''|*[!0-9]*|0|0[0-9]*) return 1 ;; esac
  signal_live -- "-$1"
}

file_mtime() {
  if stat -f %m "$1" >/dev/null 2>&1; then
    stat -f %m "$1"
  else
    stat -c %Y "$1"
  fi
}

file_age() {
  local mtime now
  mtime=$(file_mtime "$1" 2>/dev/null) || { printf '%s' 999999; return; }
  now=$(date +%s)
  printf '%s' "$((now - mtime))"
}

live_count() {
  local file pid pgid count
  count=0
  [ -d "$SLOT_DIR" ] || { printf '0\n'; return; }
  for file in "$SLOT_DIR"/*; do
    [ -f "$file" ] || continue
    read -r pid pgid <"$file" || true
    if [ -n "$pgid" ]; then is_group_live "$pgid"; else is_pid_live "$pid"; fi && count=$((count + 1))
  done
  printf '%s\n' "$count"
}

list_slots() {
  local file pid pgid age state note
  [ -d "$SLOT_DIR" ] || return 0
  for file in "$SLOT_DIR"/*; do
    [ -f "$file" ] || continue
    read -r pid pgid <"$file" || true
    age=$(file_age "$file")
    state=live
    if [ -n "$pgid" ]; then is_group_live "$pgid"; else is_pid_live "$pid"; fi || state=stale
    note=$(cat "$NOTES_DIR/${file##*/}" 2>/dev/null || true)
    printf '%s pid=%s age=%ss note=%s %s\n' "${file##*/}" "${pid:-invalid}" "$age" "${note:--}" "$state"
  done
}

clear_lock() {
  local expected_holder=$1 expected_started=$2 deadline=${3:-} holder started displaced="$LOCK_DIR.stale.$$"
  while ! mkdir "$RECLAIM_DIR" 2>/dev/null; do
    if ! test -d "$RECLAIM_DIR"; then
      probe_slot_dir
    else
      [ -n "$deadline" ] && [ "$(date +%s)" -ge "$deadline" ] && return 75
      [ "$(file_age "$RECLAIM_DIR")" -gt "$LOCK_MAX_AGE" ] && rmdir "$RECLAIM_DIR" 2>/dev/null && continue
    fi
    if [ -n "$deadline" ] && [ "$(date +%s)" -ge "$deadline" ]; then
      lock_path_is_not_directory "$RECLAIM_DIR" && { cannot_use_lock_path "$RECLAIM_DIR"; return $?; }
      return 75
    fi
    sleep 1
  done
  [ -d "$LOCK_DIR" ] || { rmdir "$RECLAIM_DIR" 2>/dev/null || true; return 0; }
  holder=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
  started=$(cat "$LOCK_DIR/started" 2>/dev/null || true)
  if [ "$holder" != "$expected_holder" ] || [ "$started" != "$expected_started" ]; then
    rmdir "$RECLAIM_DIR" 2>/dev/null || true
    return 1
  fi
  mv "$LOCK_DIR" "$displaced" 2>/dev/null || { rmdir "$RECLAIM_DIR" 2>/dev/null || true; return 1; }
  rm -f "$displaced/pid" "$displaced/started"
  rmdir "$displaced" 2>/dev/null || { rmdir "$RECLAIM_DIR" 2>/dev/null || true; return 1; }
  rmdir "$RECLAIM_DIR" 2>/dev/null || true
  return 0
}

take_lock() {
  local deadline=${1:-} holder started reclaim_status
  mkdir -p "$SLOT_DIR" 2>/dev/null || { cannot_write_slot_dir; return $?; }
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    if ! test -d "$LOCK_DIR"; then
      probe_slot_dir
    else
      holder=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
      started=$(cat "$LOCK_DIR/started" 2>/dev/null || true)
      if { [ -n "$holder" ] && ! is_pid_live "$holder"; } || { [ -z "$holder" ] && [ "$(file_age "$LOCK_DIR")" -gt "$LOCK_MAX_AGE" ]; }; then
        clear_lock "$holder" "$started" "$deadline"
        reclaim_status=$?
        [ "$reclaim_status" -eq 75 ] && return 75
        if [ "$reclaim_status" -ne 0 ]; then
          [ -n "$deadline" ] && [ "$(date +%s)" -ge "$deadline" ] && return 75
          sleep 1
          continue
        fi
        continue
      fi
    fi
    if [ -n "$deadline" ] && [ "$(date +%s)" -ge "$deadline" ]; then
      lock_path_is_not_directory "$LOCK_DIR" && { cannot_use_lock_path "$LOCK_DIR"; return $?; }
      return 75
    fi
    sleep 1
  done
  printf '%s\n' "$$" >"$LOCK_DIR/pid"
  date +%s >"$LOCK_DIR/started"
  LOCK_HELD=1
}

release_lock() {
  [ -d "$LOCK_DIR" ] || return 0
  [ "$(cat "$LOCK_DIR/pid" 2>/dev/null || true)" = "$$" ] || return 0
  # Finish both removals before the parent handles a signal. Otherwise its
  # EXIT cleanup can see our lock without its owner metadata and leave a lease.
  (
    trap '' INT TERM HUP
    rm -f "$LOCK_DIR/pid" "$LOCK_DIR/started"
    rmdir "$LOCK_DIR" 2>/dev/null || true
  )
  LOCK_HELD=0
}

cleanup() {
  local status=$? slot_pid='' pid_group='' deadline
  stop_watch
  stop_probe
  [ "$LOCK_HELD" -eq 1 ] && release_lock
  [ -n "$SLOT_FILE" ] || return 0
  deadline=$(( $(date +%s) + 1 ))
  CLEANUP_MODE=1
  if take_lock "$deadline"; then
    read -r slot_pid pid_group 2>/dev/null <"$SLOT_FILE" || true
    if [ "$slot_pid" = "$CHILD_PID" ]; then
      pid_group=${pid_group:-$CHILD_PID}
      terminate_group "$pid_group"
      rm -f "$SLOT_FILE" "$NOTES_DIR/$JOB_NAME" "$IDS_DIR/$JOB_NAME"
    fi
    release_lock
  else
    terminate_group "$CHILD_PID"
  fi
  CLEANUP_MODE=0
  return "$status"
}

terminate_group() {
  local pgid=$1 deadline
  is_group_live "$pgid" || return 0
  kill -TERM -- "-$pgid" 2>/dev/null || true
  deadline=$(( $(date +%s) + KILL_GRACE ))
  while is_group_live "$pgid" && [ "$(date +%s)" -lt "$deadline" ]; do sleep 1; done
  is_group_live "$pgid" && kill -KILL -- "-$pgid" 2>/dev/null || true
}

forward_signal() {
  local code=$2
  KILL_CODE=$code
  if [ -n "$CHILD_PID" ] && is_pid_live "$CHILD_PID"; then
    # Bash starts asynchronous children with SIGINT ignored. On macOS's Bash
    # 3.2, a child cannot install an INT trap when it inherited that ignored
    # disposition, so use TERM for reliable teardown of the child.
    emit_killed
    terminate_group "$CHILD_PID"
    wait "$CHILD_PID" 2>/dev/null || true
  fi
  # Bash 3.2 runs a second identical signal after the first exit, which skips the EXIT trap and its cleanup.
  trap '' INT TERM HUP
  exit "$code"
}

valid_name() {
  case $1 in
    .*|*[!A-Za-z0-9_.-]*|*/*|*' '*|-*|*-) return 1 ;;
  esac
  case $1 in *-*-*) ;; *-*) return 0 ;; *) return 1 ;; esac
}

stop_probe() {
  [ -n "$PROBE_PID" ] || return 0
  kill -KILL "$PROBE_PID" 2>/dev/null || true
  wait "$PROBE_PID" 2>/dev/null
  rm -f "$SLOT_DIR/.identity.$$"
  PROBE_PID=''
}

# Sets IDENTITY to `<start> <name>`, empty after IDENTITY_LIMIT seconds. Never call it with the slot lock held.
# It runs while the job runs: no command substitution and no second job-control group, so bash prints nothing of its own.
read_identity() {
  local out="$SLOT_DIR/.identity.$$" ticks=0
  IDENTITY=
  [ -n "${ORCH_LOADER_PYTHON:-}" ] || return 0
  "$ORCH_LOADER_PYTHON" -I "$IDENTITY_SCRIPT" "$1" </dev/null >"$out" 2>/dev/null &
  PROBE_PID=$!
  while is_pid_live "$PROBE_PID" && [ "$ticks" -lt "$((IDENTITY_LIMIT * 10))" ]; do sleep 0.1; ticks=$((ticks + 1)); done
  is_pid_live "$PROBE_PID" || read -r IDENTITY 2>/dev/null <"$out" || true
  stop_probe
}

record_identity() {
  local start='' rest=''
  read_identity "$2"
  read -r start rest <<<"$IDENTITY"
  if [ -n "$start" ]; then
    mkdir -p "$IDS_DIR" 2>/dev/null && printf '%s %s\n' "$2" "$start" >"$IDS_DIR/$1" 2>/dev/null && return 0
  fi
  is_pid_live "$2" || return 0
  printf 'heavy-slot: no start time recorded for pid %s; heavy-slot stop will refuse slot %s\n' "$2" "$1" >&2
}

# Succeeds when the slot's pid is the process take started; sets STOP_PID, else STOP_REASON.
verify_slot_process() {
  local name=$1 pid='' rest='' recorded_pid='' recorded_start='' start=''
  STOP_PID=
  STOP_COMMAND=
  read -r pid rest 2>/dev/null <"$SLOT_DIR/$name" || true
  is_pid_live "$pid" || { STOP_REASON="pid ${pid:-missing} is not running"; return 1; }
  read -r recorded_pid recorded_start 2>/dev/null <"$IDS_DIR/$name" || true
  [ -n "$recorded_start" ] || { STOP_REASON="no start time is recorded for pid $pid"; return 1; }
  [ "$recorded_pid" = "$pid" ] || { STOP_REASON="the start time record is for pid $recorded_pid, the slot holds pid $pid"; return 1; }
  read_identity "$pid"
  read -r start STOP_COMMAND <<<"$IDENTITY"
  [ -n "$start" ] || { STOP_REASON="cannot read the start time of pid $pid"; return 1; }
  [ "$start" = "$recorded_start" ] || { STOP_REASON="pid $pid has another start time (pid reused)"; return 1; }
  STOP_PID=$pid
}

stop_say() { printf 'heavy-slot: stop %s: %s\n' "$JOB_NAME" "$1"; }

stop_refuse() {
  stop_say "refused: $1; nothing signalled" >&2
  exit 65
}

# Takes no lock: each check reads the slot file once, just before its signal.
stop_slot() {
  local name=$1 pid deadline held='' rest=''
  JOB_NAME=$name
  [ -f "$SLOT_DIR/$name" ] || die "no slot named $name"
  orch_python >/dev/null 2>&1 || true
  trap stop_probe EXIT
  verify_slot_process "$name" || stop_refuse "$STOP_REASON"
  pid=$STOP_PID
  if kill -TERM "$pid" 2>/dev/null; then
    stop_say "sent TERM to pid $pid (${STOP_COMMAND:-name unknown})"
  else
    is_pid_live "$pid" && stop_refuse "cannot signal pid $pid"
    stop_say "pid $pid ended before TERM"
  fi
  deadline=$(( $(date +%s) + KILL_GRACE ))
  while is_pid_live "$pid" && [ "$(date +%s)" -lt "$deadline" ]; do sleep 1; done
  if is_pid_live "$pid"; then
    if verify_slot_process "$name" && [ "$STOP_PID" = "$pid" ]; then
      kill -KILL "$pid" 2>/dev/null && stop_say "sent KILL to pid $pid after ${KILL_GRACE}s"
    elif is_pid_live "$pid"; then
      stop_say "no KILL: the slot no longer matches pid $pid" >&2
      exit 65
    fi
  fi
  # The take wrapper ends the rest of the job's process group, then removes the slot file.
  deadline=$(( $(date +%s) + KILL_GRACE + 5 ))
  while :; do
    held=
    read -r held rest 2>/dev/null <"$SLOT_DIR/$name" || true
    [ "$held" = "$pid" ] || { stop_say "pid $pid stopped; slot removed"; return 0; }
    [ "$(date +%s)" -lt "$deadline" ] || break
    sleep 1
  done
  stop_say "slot file still holds pid $pid; check heavy-slot list and process group $pid" >&2
  exit 1
}

take_slot() {
  local name=$1 max=$2 existing_pid='' existing_group='' count status deadline now remaining pause waited=0
  shift 2
  probe_slot_dir
  orch_python >/dev/null 2>&1 || true
  JOB_NAME=$name
  SLOT_FILE="$SLOT_DIR/$name"
  deadline=$(( $(date +%s) + max ))
  while :; do
    if ! take_lock "$deadline"; then
      printf 'NEED SLOT: %s waited %ss for one of %s heavy slots\n' "$name" "$WAIT_MAX" "$SLOT_MAX" >&2
      exit 75
    fi
    read -r existing_pid existing_group 2>/dev/null <"$SLOT_FILE" || true
    if { [ -n "${existing_group:-}" ] && is_group_live "$existing_group"; } || is_pid_live "$existing_pid"; then
      release_lock
      printf 'heavy-slot: slot %s is already live (pid %s)\n' "$name" "$existing_pid" >&2
      exit 65
    fi
    { [ -e "$SLOT_FILE" ] || [ -L "$SLOT_FILE" ]; } && ! rm -f "$SLOT_FILE" && { release_lock; die "cannot replace $SLOT_FILE"; }
    count=$(live_count)
    if [ "$count" -lt "$SLOT_MAX" ]; then
      : >"$SLOT_FILE" || { release_lock; die "cannot create $SLOT_FILE"; }
      trap cleanup EXIT
      trap 'forward_signal INT 130' INT
      trap 'forward_signal TERM 143' TERM
      trap 'forward_signal HUP 129' HUP
      mkdir -p "$NOTES_DIR" 2>/dev/null && printf '%s\n' "$NOTE" >"$NOTES_DIR/$name" 2>/dev/null
      JOB_START=$(date +%s)
      exec 3<&0
      set -m
      ( trap - INT; exec "$@" ) <&3 3<&- &
      CHILD_PID=$!
      set +m
      exec 3<&-
      # A rename, so a reader without the lock never sees part of a pid.
      if ! { printf '%s\n' "$CHILD_PID" >"$SLOT_DIR/.slot.$$" && mv -f "$SLOT_DIR/.slot.$$" "$SLOT_FILE"; }; then
        terminate_group "$CHILD_PID"
        wait "$CHILD_PID" 2>/dev/null || true
        rm -f "$SLOT_FILE" "$SLOT_DIR/.slot.$$"
        release_lock
        die "cannot write $SLOT_FILE"
      fi
      release_lock
      if [ "$LONG_RUN" -gt 0 ]; then
        start_watch "$CHILD_PID"
      fi
      record_identity "$name" "$CHILD_PID"
      wait "$CHILD_PID"
      status=$?
      stop_watch
      if [ "$status" -ne 0 ]; then
        emit_event FAIL "$CHILD_PID" "code=$status elapsed=$(job_elapsed)"
      fi
      exit "$status"
    fi
    release_lock
    if [ "$waited" -eq 0 ]; then
      waited=1
      emit_event WAIT "$$" "slots=$count/$SLOT_MAX"
    fi
    now=$(date +%s)
    if [ "$now" -ge "$deadline" ]; then
      printf 'NEED SLOT: %s waited %ss for one of %s heavy slots\n' "$name" "$WAIT_MAX" "$SLOT_MAX" >&2
      exit 75
    fi
    pause=$((5 + RANDOM % 6))
    remaining=$((deadline - now))
    [ "$pause" -le "$remaining" ] || pause=$remaining
    sleep "$pause"
  done
}

[ "$#" -gt 0 ] || usage
case $1 in
  count)
    [ "$#" -eq 1 ] || usage
    live_count
    ;;
  list)
    [ "$#" -eq 1 ] || usage
    list_slots
    ;;
  stop)
    [ "$#" -eq 2 ] || usage
    valid_name "$2" || die "name must be <architect>-<job> and contain no spaces or /"
    stop_slot "$2"
    ;;
  take)
    shift
    [ "$#" -ge 3 ] || usage
    NAME=$1
    shift
    valid_name "$NAME" || die "name must be <architect>-<job> and contain no spaces or /"
    while :; do
      case ${1:-} in
        --wait-max) [ "$#" -ge 3 ] || usage; WAIT_MAX=$2; shift 2 ;;
        --note) [ "$#" -ge 3 ] || usage; NOTE=$(clean_note "$2"); shift 2 ;;
        *) break ;;
      esac
    done
    case $WAIT_MAX in ''|*[!0-9]*) die '--wait-max must be a non-negative number of seconds' ;; esac
    WAIT_MAX=$((10#$WAIT_MAX))
    [ "${1:-}" = -- ] || usage
    shift
    [ "$#" -gt 0 ] || usage
    take_slot "$NAME" "$WAIT_MAX" "$@"
    ;;
  *) usage ;;
esac
